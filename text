    public static void Main()
    {
        Console.Write("Enter time limit in minutes (default is 60): ");
        string input = Console.ReadLine();
        int limitMinutes = 60;

        if (!int.TryParse(input, out limitMinutes) || limitMinutes <= 0)
        {
            Console.WriteLine("Invalid input. Using default limit of 60 minutes.");
            limitMinutes = 60;
        }

        DateTime startTime = DateTime.Now;
        DateTime endTime = startTime.AddMinutes(limitMinutes);

        // NOTE: Your condition below checked 6:30 PM, but this message said 6:00 PM.
        // Update one or the other to match. Here I set the message to 6:30 PM to match the condition.
        Console.WriteLine($"Focus. Understand.Everything revolves around these names. Master the,. Think deep. Will run until {endTime:t} or until 6:30 PM AEST.");

        TimeZoneInfo aestZone = TimeZoneInfo.FindSystemTimeZoneById("AUS Eastern Standard Time");

        int nameIndex = 0;

        while (true)
        {
            DateTime now = DateTime.Now;
            DateTime aestNow = TimeZoneInfo.ConvertTime(now, aestZone);

            // If you want 6:00 PM, change (aestNow.Hour == 18 && aestNow.Minute == 30) to (aestNow.Hour == 18 && aestNow.Minute == 0).
            if (now >= endTime || (aestNow.Hour == 18 && aestNow.Minute == 30))
            {
                Console.WriteLine("Stopping: Time limit reached or it's 6:30 PM AEST.");
                break;
            }

            mouse_event(MOUSEEVENTF_MOVE, 0, 1, 0, 0);

            string name = allahNames[nameIndex];
            string meaning = AllahNamesMeanings.TryGetValue(name, out var m)
                ? m
                : "(meaning not found)";

            Console.WriteLine($"{aestNow:T} - {name} — {meaning} \n");

            nameIndex = (nameIndex + 1) % allahNames.Length;
            Thread.Sleep(20000);
        }

        Console.WriteLine(" Jiggler stopped.");
